# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit syntax files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.webmanifest text eol=lf

# Binary asset files
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
